# Local development — loaded by Vite automatically during `npm run dev`.
# Use a relative path so Vite's built-in proxy forwards /api → localhost:4000
# on the SAME origin (port 5173). This avoids all cross-origin cookie issues.
# Do NOT use http://localhost:4000/api here — that bypasses the proxy and
# causes the session cookie to be treated as cross-origin, breaking sessions.
VITE_API_BASE_URL=/api
