# Copy this file to `.env` in frontend/ if the backend is running on a
# different host/port than the frontend (e.g. separate local ports, or
# separate services in production). Not required for local dev if both
# run on localhost with Vite's default setup — VITE_API_BASE_URL falls
# back to '/api' otherwise.

VITE_API_BASE_URL=http://localhost:4000/api
