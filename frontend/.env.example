# frontend/.env.example
# ─────────────────────────────────────────────────────────────────────────────
# Vite bakes this variable into the production bundle at build time.
# It is read by both:
#   src/api/api.js          — Axios baseURL for all API requests
#   src/utils/imageUrl.js   — derives the backend origin for image URLs
#
# LOCAL DEVELOPMENT
#   Copy this file to .env.development (already created in the repo) or
#   to .env (which Vite also loads). The value below is the local backend.
#   Vite's dev-server proxy (/api → 4000, /uploads → 4000) handles requests
#   made without the full origin, but imageUrl.js constructs absolute URLs
#   so the correct localhost value is required here too.
#
# PRODUCTION (Render)
#   Set VITE_API_BASE_URL in the Render dashboard → Environment for the
#   frontend service (or update render.yaml). The value must match the
#   actual deployed backend URL including the /api suffix.
#   Example: https://pawtrack-backend-6n0t.onrender.com/api
#   .env.production in the repo already contains this value and Render
#   will pick it up automatically during `npm run build`.

VITE_API_BASE_URL=http://localhost:4000/api
