# Copy this file to `.env` in backend/ and fill in real values.
# Every variable here is read somewhere in db.js or server.js.
# Safe local-dev defaults are baked into the code for most variables.

# ── MySQL connection ─────────────────────────────────────────────────────────
# For local dev, keep the defaults below.
# For Render deployment, set these in the Render dashboard environment variables.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=pawtrack

# Optional: override the default MySQL port (3306). Most hosted providers
# (PlanetScale, Aiven, Railway) use a non-standard port — check your provider.
# DB_PORT=3306

# Set DB_SSL=true when connecting to a cloud provider that requires TLS
# (PlanetScale, Aiven, Railway). Leave blank or unset for local dev.
# DB_SSL=true

# ── Express session ──────────────────────────────────────────────────────────
# REQUIRED in production — use a long random string (32+ chars).
# Render can generate this automatically (render.yaml: generateValue: true).
SESSION_SECRET=change-me-in-production

# ── CORS ─────────────────────────────────────────────────────────────────────
# The deployed frontend origin. Set this AFTER the frontend service is live.
# Example: https://pawtrack-frontend.onrender.com
FRONTEND_URL=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
