# Copy this file to `.env` in backend/ and fill in real values.
# Every variable here is read somewhere in db.js or server.js — confirmed via
# grep during Prompt 11 integration review. None are optional extras; all
# have safe local-dev defaults baked into the code except where noted.

# MySQL connection (used by db.js's pool, and reused by server.js's session
# store — there is only one set of DB credentials in the whole app)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=pawtrack

# Express session
SESSION_SECRET=change-me-in-production

# CORS: the deployed frontend origin, in addition to the localhost dev
# origins already hardcoded in server.js
FRONTEND_URL=

# Server
PORT=4000
NODE_ENV=development
